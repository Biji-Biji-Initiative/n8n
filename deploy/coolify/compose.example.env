# Validation-only values. Never use this file to deploy or add real secrets.
N8N_ENVIRONMENT=dev
# Production must override this with the observed 1.16.0 immutable digest until
# source-data restoration and cutover have completed.
N8N_IMAGE=n8nio/n8n:2.6.3
N8N_DATABASE=n8n
N8N_DB_PASSWORD=validation-only-db-password
N8N_ENCRYPTION_KEY=validation-only-encryption-key
N8N_HOST=n8n-dev.deploy.example.invalid
N8N_PUBLIC_URL=https://n8n-dev.deploy.example.invalid
GENERIC_TIMEZONE=Asia/Kuala_Lumpur
# The source-controlled recovery services are no-ops for validation/nonprod.
# Production must set this to true for its first target deployment and provide
# a fully read-verified dump plus home archive and their SHA-256 values.
N8N_RESTORE_ENABLED=false
